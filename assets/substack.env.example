# Example environment configuration for the substack-extraction skill.
# Copy this outside the skill directory and fill in local, non-committed values.

# Root directory where exported Substack archives should be written.
# Explicit --output-root CLI values override this variable.
SUBSTACK_EXPORT_ROOT=/path/to/substack_exports

# Path to an authorized Netscape cookies.txt export for Substack access.
# Explicit --cookies CLI values and JSON config cookies override this variable.
SUBSTACK_COOKIES=/path/to/cookies.txt
